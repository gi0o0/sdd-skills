{
  "name": "default",
  "description": "Flujo SDD para Node.js con TypeScript",
  "phases": [
    {
      "name": "specify",
      "description": "Genera los requisitos a partir de la HU",
      "command": "spec-specify",
      "readsStory": true,
      "asksQuestions": true,
      "produces": {
        "file": "specify.md",
        "description": "Requisitos y preguntas abiertas"
      },
      "tools": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny"
      },
      "timeoutS": 3600,
      "idleTimeoutS": 300
    },
    {
      "name": "plan",
      "description": "Disena la solucion a partir de los requisitos",
      "command": "spec-plan",
      "requires": [
        "specify.md"
      ],
      "produces": {
        "file": "plan.md",
        "description": "Diseno tecnico"
      },
      "tools": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny"
      },
      "timeoutS": 3600,
      "idleTimeoutS": 300
    },
    {
      "name": "tasks",
      "description": "Divide el diseno en tareas",
      "command": "spec-tasks",
      "requires": [
        "plan.md"
      ],
      "produces": {
        "file": "tasks.md",
        "description": "Lista de tareas"
      },
      "tools": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny"
      },
      "timeoutS": 3600,
      "idleTimeoutS": 300
    },
    {
      "name": "implement",
      "description": "Implementa las tareas en el codigo",
      "command": "spec-implement",
      "requires": [
        "tasks.md"
      ],
      "produces": {
        "file": "implement.md",
        "description": "Resumen de la implementacion y de la revision"
      },
      "writes": [
        "src/",
        "tests/"
      ],
      "tools": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny"
      },
      "timeoutS": 7200,
      "idleTimeoutS": 900
    },
    {
      "name": "review",
      "description": "Revisa el codigo implementado y corrige los problemas",
      "command": "spec-review",
      "requires": [
        "implement.md"
      ],
      "writes": [
        "src/",
        "tests/"
      ],
      "tools": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "task": "allow",
        "skill": "allow",
        "bash": "deny",
        "webfetch": "deny"
      },
      "timeoutS": 3600,
      "idleTimeoutS": 600
    }
  ]
}
